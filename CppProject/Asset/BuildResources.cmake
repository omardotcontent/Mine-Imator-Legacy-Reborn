set(ASSET_ROOT "${CMAKE_CURRENT_SOURCE_DIR}/Asset")
file(GLOB_RECURSE ASSETS CONFIGURE_DEPENDS RELATIVE "${CMAKE_CURRENT_SOURCE_DIR}"
	"${ASSET_ROOT}/*.png" "${ASSET_ROOT}/*.vsh" "${ASSET_ROOT}/*.fsh" "${ASSET_ROOT}/*.glsl" "${ASSET_ROOT}/*.d3d")
# A local CppGen run may leave sprite copies here. Use the GameMaker project directly.
list(FILTER ASSETS EXCLUDE REGEX "^Asset/Sprites/")
source_group(TREE "${ASSET_ROOT}" FILES ${ASSETS})
add_custom_target(Assets SOURCES ${ASSETS})

function(xml_escape out value)
	string(REPLACE "&" "&amp;" value "${value}")
	string(REPLACE "<" "&lt;" value "${value}")
	string(REPLACE ">" "&gt;" value "${value}")
	string(REPLACE "\"" "&quot;" value "${value}")
	set(${out} "${value}" PARENT_SCOPE)
endfunction()

set(INDEX_XML "<RCC>\n\t<qresource prefix=\"/\">\n")
foreach(asset IN LISTS ASSETS)
	string(REGEX REPLACE "^Asset/" "" alias "${asset}")
	xml_escape(alias "${alias}")
	xml_escape(path "${CMAKE_CURRENT_SOURCE_DIR}/${asset}")
	string(APPEND INDEX_XML "\t\t<file alias=\"${alias}\">${path}</file>\n")
endforeach()

# Match the native sprite registrations with the frame order in each .yy file.
# CppGen's other output contains hand-edited fork features, so leave it untouched.
set(sprite_root "${CMAKE_CURRENT_SOURCE_DIR}/../GmProject/sprites")
set(mappings "${CMAKE_CURRENT_SOURCE_DIR}/Generated/Mappings.cpp")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${mappings}")
file(READ "${mappings}" mapping_source)
string(REGEX MATCHALL "AddSprite\\(\"[^\"]+\", [A-Za-z0-9_]+, [0-9]+," registrations "${mapping_source}")
if (NOT registrations)
	message(FATAL_ERROR "No native sprite registrations found in ${mappings}")
endif()
foreach(registration IN LISTS registrations)
	string(REGEX MATCH "AddSprite\\(\"([^\"]+)\", [A-Za-z0-9_]+, ([0-9]+)," _ "${registration}")
	set(sprite "${CMAKE_MATCH_1}")
	set(expected_frames "${CMAKE_MATCH_2}")
	set(sprite_metadata "${sprite_root}/${sprite}/${sprite}.yy")
	set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${sprite_metadata}")
	file(READ "${sprite_metadata}" sprite_source)
	string(REGEX MATCHALL "\"resourceType\"[ \t]*:[ \t]*\"GMSpriteFrame\"[^}]*" frames "${sprite_source}")
	list(LENGTH frames frame_count)
	if (NOT frame_count EQUAL expected_frames)
		message(FATAL_ERROR "${sprite}: native build expects ${expected_frames} frames but ${sprite_metadata} lists ${frame_count}")
	endif()
	set(index 0)
	foreach(frame IN LISTS frames)
		string(REGEX MATCH "\"name\"[ \t]*:[ \t]*\"([A-Za-z0-9-]+)\"" frame_name "${frame}")
		set(png "${sprite_root}/${sprite}/${CMAKE_MATCH_1}.png")
		if (NOT frame_name OR NOT EXISTS "${png}")
			message(FATAL_ERROR "Missing ${sprite} frame ${index}: ${png}")
		endif()
		xml_escape(path "${png}")
		string(APPEND INDEX_XML "\t\t<file alias=\"Sprites/${sprite}_frame_${index}.png\">${path}</file>\n")
		math(EXPR index "${index} + 1")
	endforeach()
endforeach()

string(APPEND INDEX_XML "\t</qresource>\n</RCC>\n")
set(QT_INDEX_FILE "${CMAKE_CURRENT_BINARY_DIR}/index.qrc")
file(CONFIGURE OUTPUT "${QT_INDEX_FILE}" CONTENT "${INDEX_XML}" @ONLY)
